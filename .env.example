# =============================================================================
# RoomHub Platform - Local Environment Variables Template
# Copy to .env and replace placeholder values before running.
# NEVER commit .env or real secrets to Git.
# =============================================================================

# --- Infrastructure (Docker Compose) ---
POSTGRES_DB=roomhub
POSTGRES_USER=roomhub_app
POSTGRES_PASSWORD=change_me_local
POSTGRES_PORT=5432

REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

RABBITMQ_DEFAULT_USER=roomhub_app
RABBITMQ_DEFAULT_PASS=change_me_local
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://roomhub_app:change_me_local@localhost:5672

# --- Per-Service Database URLs (Prisma schema-per-service) ---
IDENTITY_DATABASE_URL=postgresql://identity_app:change_me_local@localhost:5432/roomhub?schema=identity
LISTING_DATABASE_URL=postgresql://listing_app:change_me_local@localhost:5432/roomhub?schema=listing
BOOKING_DATABASE_URL=postgresql://booking_app:change_me_local@localhost:5432/roomhub?schema=booking
PAYMENT_DATABASE_URL=postgresql://payment_app:change_me_local@localhost:5432/roomhub?schema=payment
NOTIFICATION_DATABASE_URL=postgresql://notification_app:change_me_local@localhost:5432/roomhub?schema=notification

# --- App & Service Ports ---
STOREFRONT_PORT=3000
ADMIN_WEB_PORT=3001
API_GATEWAY_PORT=4000
IDENTITY_SERVICE_PORT=4001
LISTING_SERVICE_PORT=4002
BOOKING_SERVICE_PORT=4003
PAYMENT_SERVICE_PORT=4004
NOTIFICATION_SERVICE_PORT=4005

# --- Auth / Security ---
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# --- Media Storage (Cloudinary / Cloudflare R2 for photos & 360° panoramas) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Payment Gateway (payOS) ---
# Obtain from payOS Payment Channel dashboard; verify against current payOS docs.
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=
PAYOS_RETURN_URL=http://localhost:3000/booking/payment-return
PAYOS_CANCEL_URL=http://localhost:3000/booking/payment-cancel

# --- Platform Defaults (Overridable in Admin PlatformSetting) ---
COMMISSION_DEFAULT_RATE=0.40
DEPOSIT_ENABLED_DEFAULT=false
DEPOSIT_HOLD_HOURS_DEFAULT=24
